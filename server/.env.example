NODE_ENV=development
PORT=5001                                  # must match the proxy target in client/vite.config.ts
CLIENT_ORIGIN=http://localhost:5173        # used for CORS and for the link inside verification emails

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=nestwell_bt
DB_SSL=true                                # set false for a local MySQL without TLS

JWT_ACCESS_SECRET=replace_with_64_char_random_hex_access_secret_key_for_nestwell_bt
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_refresh_secret_key_for_nestwell_bt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=14

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------
# console = print the code and link in the server log (local development only; refused in production)
# smtp    = send real email through the server below
EMAIL_PROVIDER=console
MAIL_FROM="NestWell.BT <no-reply@yourdomain.bt>"

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

EMAIL_VERIFICATION_TTL_MINUTES=30          # how long a code / link stays valid
EMAIL_RESEND_COOLDOWN_SECONDS=60           # minimum gap between emails to the same account
EMAIL_VERIFY_MAX_ATTEMPTS=5                # wrong codes allowed before a new code is required

# ---------------------------------------------------------------------------
# SMS (only used by the existing phone-OTP password reset)
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_GATEWAY_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=NestWellBT
